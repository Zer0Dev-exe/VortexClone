# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
# Obtenido en Discord Developer Portal -> Tu App -> OAuth2 -> Client Secret
CLIENT_SECRET=your_client_secret_here

# MongoDB Atlas Connection URI
# Obtén tu URI en https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb+srv://usuario:password@cluster0.abcde.mongodb.net/vortex?retryWrites=true&w=majority

# Bot Defaults
DEFAULT_PREFIX=>>

# Optional Guild ID for instant Slash Command registration during development
DEV_GUILD_ID=

# Cosmic Web Dashboard Settings
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=cosmic-vortex-super-secret-session-key-2026

